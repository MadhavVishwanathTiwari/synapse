# Copy to .env.local and fill in. .env.local is gitignored — never commit real values.
#
# Key routing rules (enforced in docs/CONVENTIONS.md):
#   - Application reads/writes go through supabase-js over NEXT_PUBLIC_SUPABASE_URL.
#     The three Postgres URIs below are for TOOLING ONLY, not app runtime.
#   - Anything NEXT_PUBLIC_* is shipped to the browser. Never put a secret there.

# ---------------------------------------------------------------- Supabase

# Direct connection (:5432). Migrations and DDL only — DDL cannot run over a pooler.
SUPABASE_DIRECT_URI=

# Transaction pooler (:6543, PgBouncer). For raw pooled connections from serverless.
# MUST run with prepared statements disabled — transaction-mode pooling does not
# support them, and ORMs that assume otherwise fail intermittently under load.
SUPABASE_TRXN_URI=

# Session pooler. Long-lived connections and IPv4-only networks.
SUPABASE_SESSION_URI=

# REST + Auth endpoint.
NEXT_PUBLIC_SUPABASE_URL=

# Browser client, and ALSO the server client for user-scoped requests.
# Low privilege, RLS enforced. Safe to expose.
#
# Server Components use this key too, paired with the user's session cookie —
# that is what makes auth.uid() resolve and RLS policies apply. Reaching for a
# privileged key on the server is the most common way people accidentally
# disable every policy in their schema.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# DANGER — both of the keys below BYPASS RLS entirely.
# sb_secret_* is the direct replacement for the legacy service_role key; it is
# not a middle privilege tier. Edge Functions and trusted server tasks only.
# Never imported under src/app/** or src/components/** — enforced by ESLint.
SUPABASE_SECRET_KEY=

# Legacy service_role JWT. Same privileges as above. Deprecated by Supabase
# end of 2026; kept because some tooling still expects it.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------- App

# Canonical origin. Used to build OAuth callbacks.
APP_URL=http://localhost:3000

# ---------------------------------------------------------------- Phase 4: Calendar

GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# 32-byte base64 key encrypting the Google refresh token at rest.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=

# ---------------------------------------------------------------- Phase 5: Telegram

# Shared secret authenticating pg_net -> Edge Function calls.
CRON_SECRET=

TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
